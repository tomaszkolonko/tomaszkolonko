---
import Layout from '../layouts/Layout.astro';
import Cal from '../components/Cal.astro';
---

<Layout 
  title="Coaching-Session buchen (60 Min.) | Thomas Kolonko"
  description="Terminbuchung für laufende Business Coaching & Mentoring Begleitungen."
>
  <header class="sticky top-0 z-50 bg-stone-50/90 backdrop-blur-md border-b border-stone-200/80">
    <div class="max-w-5xl mx-auto px-6 h-20 flex items-center justify-between">
      <a href="/" class="font-serif text-xl font-medium tracking-tight text-slate-900">
        Thomas Kolonko <span class="text-stone-400 font-sans text-sm font-normal ml-1 hidden sm:inline">| Business & Leadership Coaching</span>
      </a>
      <a href="/" class="text-sm font-medium text-emerald-800 hover:text-emerald-950 transition-colors">
        ← Zur Startseite
      </a>
    </div>
  </header>

  <main class="py-16 md:py-24 px-6">
    <div class="max-w-5xl mx-auto">
      <div class="max-w-2xl mb-10">
        <p class="text-xs font-semibold uppercase tracking-widest text-emerald-800 mb-2">Für bestehende Klient:innen</p>
        <h1 class="font-serif text-3xl sm:text-4xl text-slate-900 tracking-tight mb-3">
          Nächste Coaching-Session vereinbaren (60 Min.)
        </h1>
        <p class="text-slate-600 leading-relaxed">
          Wähle hier direkt einen passenden Termin für unsere nächste 60-minütige Sitzung (online oder vor Ort in Zürich).
        </p>
      </div>

      <!-- Hier wird dein 60-Minuten-Kalender geladen -->
      <Cal calLink="https://cal.com/thomas-kolonko/60min" namespace="session60" />
    </div>
  </main>
</Layout>