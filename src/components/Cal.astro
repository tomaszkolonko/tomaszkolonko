---
interface Props {
  calLink?: string;
  namespace?: string;
}

const { 
  calLink = "thomas-kolonko/25min", 
  namespace = "cal-booking" 
} = Astro.props;

// Entfernt "https://cal.com/" und allfällige Theme-Parameter, damit wir sie sauber selbst setzen
const cleanCalLink = calLink
  .replace(/^https?:\/\/(www\.|app\.)?cal\.com\//, '')
  .split('?')[0];

const containerId = `cal-inline-${namespace}`;
---

<div class="w-full overflow-hidden rounded-2xl border border-stone-200 bg-white p-2 sm:p-6 shadow-xs">
  <div 
    id={containerId} 
    style="width:100%;min-height:620px;height:100%;overflow:scroll"
  ></div>
</div>

<script is:inline define:vars={{ cleanCalLink, namespace, containerId }}>
  (function (C, A, L) {
    let p = function (a, ar) { a.q.push(ar); };
    let d = C.document;
    C.Cal = C.Cal || function () {
      let cal = C.Cal;
      let ar = arguments;
      if (!cal.loaded) {
        cal.ns = {};
        cal.q = cal.q || [];
        d.head.appendChild(d.createElement("script")).src = A;
        cal.loaded = true;
      }
      if (ar[0] === L) {
        const api = function () { p(api, arguments); };
        const namespace = ar[1];
        api.q = api.q || [];
        if (typeof namespace === "string") {
          cal.ns[namespace] = cal.ns[namespace] || api;
          p(cal.ns[namespace], ar);
          p(cal, ["initNamespace", namespace]);
        } else p(cal, ar);
        return;
      }
      p(cal, ar);
    };
  })(window, "https://app.cal.com/embed/embed.js", "init");

  Cal("init", namespace, { origin: "https://app.cal.com" });

  // 1. Theme direkt in den Inline-Config-Optionen auf "light" zwingen
  Cal.ns[namespace]("inline", {
    elementOrSelector: `#${containerId}`,
    calLink: cleanCalLink,
    layout: "month_view",
    config: {
      theme: "light",
    },
  });

  // 2. Exakte Farbpalette deiner Website (White, Stone, Slate & Emerald-800) übergeben
  Cal.ns[namespace]("ui", {
    theme: "light",
    hideEventTypeDetails: false,
    layout: "month_view",
    cssVarsPerTheme: {
      light: {
        "cal-brand": "#065f46",            // emerald-800 (Buttons & aktive Auswahl)
        "cal-brand-emphasis": "#064e3b",   // emerald-900 (Hover-Effekt)
        "cal-brand-text": "#ffffff",       // Weisse Schrift auf Emerald-Buttons
        "cal-bg": "#ffffff",               // Haupt-Hintergrund (Reinweiss wie deine Karte)
        "cal-bg-muted": "#fafaf9",         // stone-50 (Dezenter Hintergrund für freie Tage)
        "cal-bg-subtle": "#f5f5f4",        // stone-100 (Wochentage / Hover)
        "cal-bg-emphasis": "#e7e5e4",      // stone-200 (Aktiver Fokus)
        "cal-border": "#e7e5e4",           // stone-200 (Rahmenfarbe)
        "cal-border-default": "#e7e5e4",   // stone-200
        "cal-border-subtle": "#f5f5f4",    // stone-100
        "cal-border-booker": "#e7e5e4",    // stone-200 (Trennlinien im Kalender)
        "cal-text": "#0f172a",             // slate-900 (Hauptschrift)
        "cal-text-emphasis": "#0f172a",    // slate-900 (Überschriften & Zahlen)
        "cal-text-muted": "#475569",       // slate-600 (Beschreibungstext)
      },
    },
  });
</script>