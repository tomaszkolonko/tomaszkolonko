---
interface Props {
  /** Dein Calendly-Link, z. B. "https://calendly.com/tomaszkolonko/kennenlernen" */
  url: string;
}

const { url = "https://calendly.com/tz-kolonko/coaching-1-1" } = Astro.props;

// Fügt Parameter hinzu: blendet den doppelten Calendly-Header & das Cookie-Banner aus und setzt deine Markenfarben
const embedUrl = `${url}?hide_gdpr_banner=1&hide_event_type_details=1&background_color=ffffff&text_color=0f172a&primary_color=065f46`;
---

<div class="w-full overflow-hidden rounded-2xl border border-stone-200 bg-white shadow-xs">
  <div 
    class="calendly-inline-widget w-full" 
    data-url={embedUrl} 
    style="min-width:320px;height:700px;"
  ></div>
</div>

<script is:inline type="text/javascript" src="https://assets.calendly.com/assets/external/widget.js" async></script>