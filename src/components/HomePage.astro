---
import Layout from '../layouts/Layout.astro';
import Cal from '../components/Cal.astro';
import { homepage } from '../content/homepage';
import { homepageEn } from '../content/homepage.en';
import LanguageSwitch from '../components/LanguageSwitch.astro';
import { Image } from 'astro:assets';

import portraitImg from '../assets/portrait.jpeg';
import scaLogo from '../assets/SCA_Mitglied.svg';

interface Props {
  language?: 'de' | 'en';
}

const { language = 'de' } = Astro.props;
const isEnglish = language === 'en';
const content = isEnglish ? homepageEn : homepage;
const examplesPath = isEnglish ? '/en/coaching-examples/' : '/Moegliche-Coaching-Beispiele/';
const privacyPath = isEnglish ? '/en/privacy/' : '/datenschutz/';
const legalPath = isEnglish ? '/en/legal-notice/' : '/impressum/';
---

<Layout
  title={content.pageTitle}
  description={content.metaDescription}
  language={language}
  alternatePath={isEnglish ? '/' : '/en/'}
>
  <!-- Sticky Navigation -->
  <header class="sticky top-0 z-50 bg-stone-50/90 backdrop-blur-md border-b border-stone-200/80">
    <div class="max-w-6xl mx-auto px-6 h-20 flex items-center justify-between">
      <a href={isEnglish ? '/en/' : '/'} class="font-serif text-xl font-medium tracking-tight text-slate-900">
        {content.brand.name} <span class="text-stone-400 font-sans text-sm font-normal ml-1 hidden sm:inline">| {content.brand.descriptor}</span>
      </a>
      
      <nav class="hidden md:flex items-center gap-8 text-sm font-medium text-slate-600">
        {content.navigation.map((item) => (
          <a href={item.href} class="hover:text-emerald-800 transition-colors">{item.label}</a>
        ))}
      </nav>

      <LanguageSwitch language={language} deHref="/" enHref="/en/" />

      <a 
        href="#kontakt" 
        class="inline-flex items-center justify-center px-3 sm:px-5 py-2.5 text-xs sm:text-sm font-medium text-white bg-emerald-800 hover:bg-emerald-900 rounded-lg transition-colors shadow-xs"
      >
        {content.hero.headerAction}
      </a>
    </div>
  </header>

  <main>
    <!-- Hero Section -->
    <section class="py-20 md:py-28 px-6">
      <div class="max-w-6xl mx-auto grid md:grid-cols-12 gap-12 items-center">
        <div class="md:col-span-7 space-y-6">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-900/5 border border-emerald-900/10 text-emerald-900 text-xs font-medium tracking-wide uppercase">
            {content.hero.eyebrow}
          </div>
          
          <h1 class="font-serif text-4xl sm:text-5xl md:text-6xl text-slate-900 leading-[1.15] tracking-tight">
            {content.hero.title}
          </h1>
          
          <p class="text-lg sm:text-xl text-slate-600 leading-relaxed max-w-2xl">
            {content.hero.description}
          </p>

          <div class="pt-4 flex flex-col sm:flex-row gap-4">
            <a 
              href="#kontakt" 
              class="inline-flex items-center justify-center px-7 py-4 text-base font-medium text-white bg-emerald-800 hover:bg-emerald-900 rounded-lg transition-all shadow-sm"
            >
              {content.hero.primaryAction}
            </a>
            <a 
              href="#anliegen" 
              class="inline-flex items-center justify-center px-7 py-4 text-base font-medium text-slate-700 bg-white hover:bg-stone-100 border border-stone-200 rounded-lg transition-all"
            >
              {content.hero.secondaryAction}
            </a>
          </div>

          <div class="pt-6 border-t border-stone-200/80 flex flex-wrap gap-x-8 gap-y-2 text-xs text-slate-500 font-medium">
            {content.hero.credentials.map((credential) => (
              <span>✓ {credential}</span>
            ))}
          </div>
        </div>

        <!-- Portrait Placeholder -->
        <!-- Portrait Image -->
        <div class="md:col-span-5">
          <div class="relative aspect-4/5 rounded-2xl bg-stone-200 border border-stone-300/80 overflow-hidden shadow-lg">
            <Image 
              src={portraitImg} 
              alt={isEnglish ? 'Thomas Kolonko – Business & Leadership Coach in Zurich' : 'Thomas Kolonko – Business & Leadership Coach in Zürich'}
              class="w-full h-full object-cover object-center"
              widths={[400, 800, 1200]}
              sizes="(max-width: 768px) 100vw, 40vw"
              loading="eager"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- Challenges Section -->
    <section id="anliegen" class="py-24 bg-white px-6 border-y border-stone-200/70">
      <div class="max-w-6xl mx-auto">
        <div class="max-w-2xl mb-16">
          <p class="text-xs font-semibold uppercase tracking-widest text-emerald-800 mb-3">{content.challenges.eyebrow}</p>
          <h2 class="font-serif text-3xl sm:text-4xl text-slate-900 tracking-tight mb-4">
            {content.challenges.title}
          </h2>
          <p class="text-slate-600 leading-relaxed">
            {content.challenges.introduction}
          </p>
        </div>

        <div class="grid md:grid-cols-2 gap-8">
          {content.challenges.cards.map((item) => (
            <div class="p-8 rounded-2xl bg-stone-50 border border-stone-200/80 hover:border-emerald-800/30 transition-colors">
              <span class="inline-block text-xs font-semibold text-emerald-800 tracking-wide uppercase mb-2">
                {item.tag}
              </span>
              <h3 class="font-serif text-2xl text-slate-900 mb-3">{item.title}</h3>
              <p class="text-slate-600 leading-relaxed text-sm sm:text-base">{item.description}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Services Section -->
    <section id="angebot" class="py-24 px-6">
      <div class="max-w-6xl mx-auto">
        <div class="max-w-2xl mb-16">
          <p class="text-xs font-semibold uppercase tracking-widest text-emerald-800 mb-3">{content.services.eyebrow}</p>
          <h2 class="font-serif text-3xl sm:text-4xl text-slate-900 tracking-tight mb-4">
            {content.services.title}
          </h2>
          <p class="text-slate-600 leading-relaxed">
            {content.services.introduction}
          </p>
        </div>

        <div class="grid md:grid-cols-2 gap-8">
          {content.services.cards.map((item) => (
            <div class="bg-white p-10 rounded-2xl border border-stone-200/90 shadow-xs flex flex-col justify-between">
              <div>
                <div class="text-xs font-semibold uppercase tracking-widest text-stone-400 mb-2">{item.audience}</div>
                <h3 class="font-serif text-2xl text-slate-900 mb-4">{item.title}</h3>
                <p class="text-slate-600 mb-6 leading-relaxed">{item.description}</p>
                <ul class="space-y-3 text-sm text-slate-700 mb-8">
                  {item.points.map((point) => (
                    <li class="flex items-start gap-3">
                      <span class="text-emerald-800 font-bold">✓</span>
                      <span>{point}</span>
                    </li>
                  ))}
                </ul>
              </div>
              <a href="#kontakt" class="inline-flex items-center text-sm font-semibold text-emerald-800 hover:text-emerald-950 group">
                {item.action}
                <span class="ml-1 group-hover:translate-x-1 transition-transform">→</span>
              </a>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- About Section -->
    <section id="ueber-mich" class="py-24 bg-slate-900 text-stone-100 px-6">
      <div class="max-w-6xl mx-auto grid md:grid-cols-12 gap-12 items-center">
        <div class="md:col-span-7 space-y-6">
          <p class="text-xs font-semibold uppercase tracking-widest text-emerald-400">{content.about.eyebrow}</p>
          <h2 class="font-serif text-3xl sm:text-4xl text-white tracking-tight leading-snug">
            {content.about.title}
          </h2>
          <p class="text-stone-300 leading-relaxed">
            {content.about.introduction}
          </p>
          <p class="text-stone-300 leading-relaxed">
            {content.about.credentialLeadIn}<strong class="text-white font-medium">{content.about.credential}</strong>{content.about.credentialFollowUp}
          </p>
          <p class="text-stone-300 leading-relaxed">
            {content.about.approach}
          </p>
        </div>

        <div class="md:col-span-5 bg-slate-800/70 border border-slate-700 p-8 rounded-2xl space-y-6">
          <h3 class="font-serif text-xl text-white border-b border-slate-700 pb-3">{content.about.qualificationsTitle}</h3>
          <ul class="space-y-4 text-sm text-stone-300">
            {content.about.qualifications.map((item) => (
              <li class="flex flex-col">
                <span class="text-white font-medium">{item.title}</span>
                <span class="text-stone-400 text-xs">{item.description}</span>
              </li>
            ))}
          </ul>
		  <!-- SCA Membership Badge -->
          <div class="pt-6 border-t border-slate-700/80 flex items-center gap-4">
            <div class="bg-white p-2.5 rounded-xl shrink-0 shadow-xs">
              <Image 
                src={scaLogo} 
                alt={isEnglish ? 'Member of the Swiss Coaching Association (SCA)' : 'Mitglied der Swiss Coaching Association (SCA)'}
                class="h-10 w-auto object-contain"
              />
            </div>
            <p class="text-xs text-stone-300 leading-snug">
              {content.about.scaBadge}
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Process Section -->
    <section id="ablauf" class="py-24 px-6 bg-white border-b border-stone-200/70">
      <div class="max-w-6xl mx-auto">
        <div class="max-w-2xl mb-16">
          <p class="text-xs font-semibold uppercase tracking-widest text-emerald-800 mb-3">{content.process.eyebrow}</p>
          <h2 class="font-serif text-3xl sm:text-4xl text-slate-900 tracking-tight mb-4">
            {content.process.title}
          </h2>
          <p class="text-slate-600 leading-relaxed">
            {content.process.introduction}
          </p>
        </div>

        <div class="grid md:grid-cols-3 gap-8">
          {content.process.steps.map((item) => (
            <div class="relative p-8 rounded-2xl bg-stone-50 border border-stone-200/80">
              <div class="font-serif text-3xl text-emerald-800/40 font-semibold mb-4">{item.number}</div>
              <h3 class="font-serif text-xl text-slate-900 mb-3">{item.title}</h3>
              <p class="text-slate-600 text-sm leading-relaxed">{item.description}</p>
            </div>
          ))}
        </div>
        <div class="mt-10">
          <a
            href={examplesPath}
            class="inline-flex items-center justify-center px-7 py-4 text-base font-medium text-slate-700 bg-white hover:bg-stone-100 border border-stone-200 rounded-lg transition-all"
          >
            {content.process.examplesAction}
          </a>
        </div>
      </div>
    </section>

    <!-- Contact / Booking CTA Section -->
    <section id="kontakt" class="py-24 px-6">
      <div class="max-w-5xl mx-auto bg-white border border-stone-200 rounded-3xl p-6 sm:p-12 shadow-xs">
        <div class="text-center max-w-2xl mx-auto mb-10">
          <p class="text-xs font-semibold uppercase tracking-widest text-emerald-800 mb-3">{content.contact.eyebrow}</p>
          <h2 class="font-serif text-3xl sm:text-4xl text-slate-900 tracking-tight mb-4">
            {content.contact.title}
          </h2>
          <p class="text-slate-600 leading-relaxed">
            {content.contact.description}
          </p>
        </div>

        <!-- Eingebetteter Calendly-Kalender (Hier deinen echten Link eintragen) -->
        <Cal calLink={content.contact.calLink25} namespace={isEnglish ? 'intro-call' : 'kennenlernen'} />

        <!-- Alternative Kontaktmöglichkeiten darunter -->
        <div class="mt-10 pt-8 border-t border-stone-200/80 flex flex-col sm:flex-row items-center justify-between gap-4 text-sm text-slate-600">
          <div>
            {content.contact.alternative}
            <a href={`mailto:${content.contact.email}`} class="font-medium text-emerald-800 hover:underline ml-1">
              {content.contact.email}
            </a>
          </div>
          <a 
            href="https://www.linkedin.com/in/thomaskolonko/" 
            target="_blank" 
            rel="noopener noreferrer"
            class="inline-flex items-center font-medium text-slate-700 hover:text-emerald-800 transition-colors"
          >
            {content.contact.linkedInAction} →
          </a>
        </div>
      </div>
    </section>
  </main>

  <!-- Footer -->
  <footer class="bg-stone-100 border-t border-stone-200/80 py-12 px-6 text-sm text-slate-500">
    <div class="max-w-6xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-4">
      <div>
        <span class="font-serif text-slate-800 font-medium">{content.brand.name}</span> · {content.footer.summary}
      </div>
      <div class="flex gap-6">
        <a href={legalPath} class="hover:text-slate-900 transition-colors">{content.footer.impressum}</a>
        <a href={privacyPath} class="hover:text-slate-900 transition-colors">{content.footer.privacy}</a>
        <a href="https://www.linkedin.com/in/thomaskolonko/" target="_blank" rel="noopener noreferrer" class="hover:text-slate-900 transition-colors">{content.footer.linkedIn}</a>
      </div>
    </div>
  </footer>
</Layout>